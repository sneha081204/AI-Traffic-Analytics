# System Environment Configuration
ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=5000

# Backend & Database
DATABASE_URL=sqlite:///../storage/database.sqlite
SECRET_KEY=traffic-analytics-secret-key-super-secure-2026
CORS_ORIGINS=*

# Storage Paths
STORAGE_DIR=backend/storage
EVIDENCE_DIR=backend/storage/evidence
UPLOAD_DIR=backend/storage/uploads

# AI Vision Pipeline Configuration
AI_DEVICE=cpu # 'cpu' or 'cuda' or '0'
CONFIDENCE_THRESHOLD=0.45
IOU_THRESHOLD=0.50
BYTE_TRACK_MATCH_THRESH=0.8
TEMPORAL_VOTING_FRAMES=5 # Consecutive violation frames before confirming

# OCR Configuration
OCR_LANGUAGES=en
OCR_CONFIDENCE_THRESHOLD=0.40

# Video Stream Settings
MAX_FPS=30
FRAME_WIDTH=1280
FRAME_HEIGHT=720
